            "expression": "extension.where(url='returnedInstitution').empty() implies (extension.where(url='defaultApplied').value = true and extension.where(url='effectiveInstitution').count() = 1 and extension.where(url='effectiveInstitution').value.coding.where(system='https://fhir.sus-rda-mx.local/CodeSystem/instituciones-fase0-working' and code='IMSS-BIENESTAR').exists())",
